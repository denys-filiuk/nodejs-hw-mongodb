{
  "openapi": "3.1.0",
  "info": {
    "title": "Contact book by Illia Lukianov",
    "version": "1.0.0",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This is a documentation of Contact book"
  },
  "servers": [
    {
      "url": "https://nodejs-hw-mongodb-hmfg.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operation with contacts"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get contacts",
        "operationId": "fetchContacts",
        "description": "Get contacts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "description": "The page number for pagination (starting from 1).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 7
            }
          },
          {
            "in": "query",
            "name": "perPage",
            "description": "The number of contacts per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 20
            }
          },
          {
            "in": "query",
            "name": "name",
            "description": "Sort order for the `name` field.   Possible values: `asc` (ascending) or `desc` (descending).\n",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            },
            "example": "asc"
          },
          {
            "in": "query",
            "name": "isFavourite",
            "description": "Sort order for the `isFavourite` field.   Possible values: `asc` (ascending) or `desc` (descending).\n",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            },
            "example": "desc"
          },
          {
            "in": "query",
            "name": "contactType",
            "description": "Filter contacts by `contactType`.   Allowed values: `work`, `home`, or `personal`.\n",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["work", "home", "personal"]
            },
            "example": "work"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contacts!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPreviousPage",
                        "sortBy",
                        "sortOrder",
                        "filter"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/contact"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "perPage": {
                          "type": "integer",
                          "example": 10
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 0
                        },
                        "totalPages": {
                          "type": "integer",
                          "example": 0
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": true
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "sortBy": {
                          "type": "string",
                          "enum": ["name", "isFavourite"],
                          "example": "name"
                        },
                        "sortOrder": {
                          "type": "string",
                          "enum": ["asc", "desc"],
                          "example": "desc"
                        },
                        "filter": {
                          "type": "object",
                          "properties": {
                            "contactType": {
                              "type": "string",
                              "enum": ["work", "home", "personal"],
                              "example": "work"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Create contacts",
        "operationId": "createContacts",
        "description": "Create contacts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["name", "phoneNumber", "contactType"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact name",
                    "example": "John Deere"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Contact number",
                    "example": 380123456789
                  },
                  "email": {
                    "type": "string",
                    "description": "Contact email",
                    "example": "qwe@gmail.com"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "description": "Contact is fafourite",
                    "example": true
                  },
                  "contactType": {
                    "type": "string",
                    "enum": ["work", "home", "personal"],
                    "description": "Contact type",
                    "example": "work"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Contact avatar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/201"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get contats by id",
        "operationId": "fetchContactById",
        "description": "Get contats by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6895889e53921ad84070f388"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Patch contacts by id",
        "operationId": "patchContactById",
        "description": "Patch contacts by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6895889e53921ad84070f388"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Student name",
                    "example": "John Deere"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Contact number",
                    "example": 380123456789
                  },
                  "email": {
                    "type": "string",
                    "description": "Contact email",
                    "example": "qwe@gmail.com"
                  },
                  "isFavourite": {
                    "type": "boolean",
                    "description": "Contact is favourite",
                    "example": true
                  },
                  "contactType": {
                    "type": "string",
                    "enum": ["work", "home", "personal"],
                    "description": "Contact type",
                    "example": "work"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Contact avatar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully get student by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully patched contact"
                    },
                    "data": {
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Delete contact by id",
        "operationId": "deleteContactById",
        "description": "Delete contact by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "6895889e53921ad84070f388"
            }
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/204"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "contactType",
          "userId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Student id",
            "example": "68962e8e5ae0a5402d96f9b6"
          },
          "name": {
            "type": "string",
            "description": "Student name",
            "example": "John Deere"
          },
          "phoneNumber": {
            "type": "string",
            "description": "Contact number",
            "example": 380123456789
          },
          "email": {
            "type": "string",
            "description": "Contact email",
            "example": "qwe@gmail.com"
          },
          "isFavourite": {
            "type": "boolean",
            "description": "Contact is favourite",
            "example": true
          },
          "contactType": {
            "type": "string",
            "enum": ["work", "home", "personal"],
            "description": "Contact type",
            "example": "work"
          },
          "userId": {
            "type": "string",
            "description": "Contact id",
            "example": "6895889e53921ad84070f388"
          },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Contact avatar"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-21T17:27:59.621+00:00"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-21T17:27:59.621+00:00"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Successfully get student by id",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 200
                },
                "message": {
                  "type": "string",
                  "example": "Successfully get student"
                },
                "data": {
                  "$ref": "#/components/schemas/contact"
                }
              }
            }
          }
        }
      },
      "201": {
        "description": "Created a student",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 201
                },
                "message": {
                  "type": "string",
                  "example": "Student created successfully"
                },
                "data": {
                  "$ref": "#/components/schemas/contact"
                }
              }
            }
          }
        }
      },
      "204": {
        "description": "Deleted student"
      },
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 400
                },
                "message": {
                  "type": "string",
                  "example": "Bad Request"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "Unauthorized Error"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Student not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
                },
                "message": {
                  "type": "string",
                  "example": "Student not found"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 500
                },
                "message": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
